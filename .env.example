# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Dapatkan token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Opsional) ID Telegram Anda agar bot hanya menerima perintah dari Anda
# Dapatkan ID via bot @userinfobot di Telegram
TELEGRAM_CHAT_ID=

# ==========================================
# BASE CHAIN & CLANKER WALLET
# ==========================================
# Private key wallet deployer Anda di Base (dengan format 0x...)
# Pastikan wallet memiliki saldo ETH di Base network untuk gas fee & dev buy
PRIVATE_KEY=0x_your_private_key_here

# RPC Provider untuk Base Network
BASE_RPC_URL=https://mainnet.base.org

# Set true jika ingin mencoba bot tanpa memotong saldo ETH (simulasi)
DRY_RUN=false

# ==========================================
# GECKOTERMINAL SETTINGS
# ==========================================
# Network GeckoTerminal yang dimonitor ('base' atau 'eth')
GECKO_NETWORK=base

# Interval pengecekan trending token baru (dalam detik, default: 60)
GECKO_CHECK_INTERVAL_SEC=60

# Filter minimal volume 24 jam dalam USD (0 untuk semua)
MIN_VOLUME_USD=0

# ==========================================
# CLANKER DEPLOYMENT PARAMETERS (DEFAULT)
# ==========================================
# Auto-deploy otomatis saat ada trending baru (true / false)
AUTO_DEPLOY=false

# Dev Buy ETH amount (default: 0.000001 ETH)
DEV_BUY_ETH=0.000001

# Permanent Fee deployment (default: 3%)
PERMANENT_FEE_PERCENT=3

# Anti-Snipe / Sniper Tax duration (default: 120 detik decay)
SNIPER_TAX_DURATION_SEC=120

# Creator Vault percentage (default: 5%)
CREATOR_VAULT_PERCENT=5

# Creator Vault lockup duration (dalam hari, minimal 7 hari sesuai aturan Clanker v4)
CREATOR_VAULT_LOCKUP_DAYS=7

# Pool Configuration ('Project' = 10 range positions, atau 'Standard')
POOL_TYPE=Project

# Pengulangan deploy per token trending (default: 2x)
REPEAT_DEPLOY_COUNT=2

# Suffix nama token untuk deploy ke-2 (default: "BASE")
REPEAT_SUFFIX=BASE

# ==========================================
# AIRDROP SETTINGS (OPSIONAL)
# ==========================================
# Daftar alamat wallet untuk airdrop (pisahkan dengan koma jika ada)
AIRDROP_WALLETS=

# Lockup duration airdrop dalam hari (default: 1 hari)
AIRDROP_LOCKUP_DAYS=1
